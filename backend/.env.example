# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your_key_here
GOOGLE_CLIENT_ID=your_client_id_here
# Local SQLite by default; in production a Postgres URL (postgres://... is fine, it is normalised)
DATABASE_URL=sqlite:///./app.db
# Comma-separated browser origins allowed to call the API (production: your https frontend URL)
FRONTEND_ORIGIN=http://localhost:5173
SEC_USER_AGENT=Your Name your_email@example.com
# "production" refuses to start if a required setting is missing
APP_ENV=development
# Research runs executing at once across all users (use 1 on a 512 MB host)
MAX_CONCURRENT_RUNS=2
# Filing embeddings: "local" (default, runs a small model on this machine) or "cohere" (hosted API)
EMBEDDING_PROVIDER=local
# Only needed when EMBEDDING_PROVIDER=cohere (free trial key: https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_key_here
